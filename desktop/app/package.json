{
  "name": "unibot-desktop-app",
  "private": true,
  "version": "0.1.0",
  "description": "unibot for the desktop: the local runtime in a window, a tray, and a stage that shows where the hands are about to click.",
  "homepage": "https://github.com/unictoai/unibot",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron out/main/index.js",
    "stage-demo": "electron-vite build && electron out/main/index.js --stage-demo",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run typecheck && npm run build",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.3.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "lgy0404",
    "email": "2528379691@qq.com"
  }
}
