# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- unibot overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# UNIBOT_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.unibot)
# UNIBOT_DATA_DIR=~/.unibot
# The agent's file sandbox (default: agent.workspace from config, ./workspace)
# UNIBOT_WORKSPACE=./workspace
# openai | openai_responses
# UNIBOT_LLM_PROVIDER=openai
# UNIBOT_LLM_MODEL=deepseek-flash
# UNIBOT_LLM_BASE_URL=https://api.deepseek.com
# UNIBOT_LLM_API_KEY=
# native | prompt
# UNIBOT_LLM_TOOL_MODE=native
# ask | strict | auto
# UNIBOT_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# UNIBOT_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# UNIBOT_VAULT_KEY=
# App server (`unibot serve`): bind address, port, and a fixed access token
# UNIBOT_SERVER_HOST=0.0.0.0
# UNIBOT_SERVER_PORT=8787
# UNIBOT_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# UNIBOT_LIVE=0
