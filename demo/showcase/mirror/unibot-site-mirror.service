# One sync of the project site's mirror; unibot-site-mirror.timer runs it every minute.
# Installed by install.sh, which also links sync.sh to /usr/local/bin/unibot-site-mirror.
[Unit]
Description=unibot site mirror (unibot.cn): sync from GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# WWW_ROOT / MIRROR_* overrides, if any (see sync.sh); absent is fine
EnvironmentFile=-/etc/default/unibot-site-mirror
ExecStart=/usr/local/bin/unibot-site-mirror
