# unibot iOS · fastlane
#
# One lane: `beta` archives the app with Xcode's automatic (cloud) signing, driven entirely by an
# App Store Connect API key, and uploads the build to TestFlight for internal testers. No
# certificates or profiles live in the repository; Xcode creates and manages them through the
# key (-allowProvisioningUpdates). Run by .github/workflows/ios-testflight.yml, or by hand on a
# Mac from android/src/ios with the same environment variables:
#
#   APP_STORE_CONNECT_KEY_ID      the key's ID (10 characters)
#   APP_STORE_CONNECT_ISSUER_ID   the issuer ID (a UUID)
#   APP_STORE_CONNECT_KEY_P8      the contents of AuthKey_<ID>.p8 (PEM text)
#   APPLE_TEAM_ID                 the team the bundle ids are registered under
#   BUILD_NUMBER                  optional; CFBundleVersion for this upload (CI: the run number)
#
# See docs/ios.md.

require "tmpdir"

default_platform(:ios)

PROJECT = "Minis.xcodeproj".freeze
SCHEME = "Minis".freeze

platform :ios do
  desc "Archive unibot with automatic signing and upload it to TestFlight (internal testers)"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.utc.strftime("%Y%m%d%H%M"))

    # xcodebuild wants the key as a file; fastlane's own actions take the content.
    key_path = File.expand_path("AuthKey_#{key_id}.p8", Dir.mktmpdir("unibot-asc"))
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_KEY_P8"))
    File.chmod(0o600, key_path)
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    setup_ci if ENV["CI"] # a throwaway keychain for the managed certificates

    # The project ships with an empty DEVELOPMENT_TEAM (upstream's choice, so that anyone can
    # build it under their own team). Every target — the app, the share, widget and file
    # provider extensions — has to carry ours for the archive to sign.
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: true,
      team_id: team_id
    )

    # -allowProvisioningUpdates plus the key: Xcode registers the bundle ids, creates the
    # distribution certificate and the profiles on the fly ("cloud signing").
    signing_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{issuer_id}"
    ].join(" ")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: { signingStyle: "automatic", teamID: team_id, uploadSymbols: true },
      xcargs: "#{signing_args} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: signing_args,
      output_directory: "build",
      output_name: "unibot.ipa",
      clean: false,
      include_symbols: true,
      include_bitcode: false
    )

    # Internal testers only (the App Store Connect users you add to the internal group) — that
    # path needs no beta review. External groups do; see docs/ios.md.
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/unibot.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
