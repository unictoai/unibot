<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2 Batch H — Recent-chats widget card. Follows the system theme: the
     card fill and text colors resolve against the launcher's theme (light or
     dark) via framework attributes; the violet ring is the brand accent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?android:attr/colorBackground" />
    <stroke
        android:width="1dp"
        android:color="#33A78BFA" />
    <corners android:radius="28dp" />
</shape>
