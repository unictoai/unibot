<?xml version="1.0" encoding="utf-8"?>
<!-- unibot: what a device backup (Android 11 and earlier: full-backup-content) may copy.
     Encrypted stores cannot be read on another device anyway (the master key stays in this
     phone's keystore) and the Reach pairing tokens and API keys must not leave it at all. -->
<full-backup-content>
    <exclude domain="sharedpref" path="unibot_secure.xml" />
    <exclude domain="sharedpref" path="env_var_values.xml" />
    <exclude domain="sharedpref" path="oauth_prefs.xml" />
    <exclude domain="sharedpref" path="backup_rclone_secrets.xml" />
    <exclude domain="sharedpref" path="unibot_device_identity.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
