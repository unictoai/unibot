<?xml version="1.0" encoding="utf-8"?>
<!-- unibot: what a device backup may copy.
     Secrets stay on this phone: every EncryptedSharedPreferences store
     (encrypted stores are unreadable on another device anyway — the
     master key stays in this phone's keystore — and restoring them is
     what triggers the keystore-recovery cascade), the legacy
     `*_plain_fallback` files, the MasterKey keyset, the P4 pairing token,
     and the sandbox/session/update/log trees (SSH keys, shell history,
     multi-hundred-MB rootfs that would also blow the 25 MB Auto Backup
     quota). Chat databases (minis.db / provider.db) ARE backed up
     deliberately: they hold no keystore-bound secrets and restore
     cleanly. Generated from the EncryptedPrefsFactory call-site list;
     keep in sync when adding a store. -->
<data-extraction-rules>
    <cloud-backup>
    <exclude domain="sharedpref" path="oauth_prefs.xml" />
    <exclude domain="sharedpref" path="oauth_prefs_plain_fallback.xml" />
    <exclude domain="sharedpref" path="provider_secrets.xml" />
    <exclude domain="sharedpref" path="provider_secrets_plain_fallback.xml" />
