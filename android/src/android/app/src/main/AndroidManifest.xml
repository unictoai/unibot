<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T33: Check Update — needed to launch the system installer for the
         downloaded APK. The user must additionally grant "install unknown
         apps" for this package the first time they upgrade. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- App lock: BiometricPrompt.authenticate() throws SecurityException
         without this (normal permission, granted at install). Missing it
         crashed the app instead of showing the unlock prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- T-android-fgs-timeout-crash: switched from dataSync to mediaPlayback.
         dataSync has a hard 6h/24h cumulative cap on Android 14+, after
         which the system throws ForegroundServiceDidNotStopInTimeException
         and force-kills the process. Long-running novel-writing / shell /
         iSH sessions reliably hit this on OnePlus PJZ110 / Android 16.
         mediaPlayback has no such cap and AOSP's foreground-service-type
         validation accepts it as long as the permission is held; the
         "must use MediaStyle / play actual media" rule is Play Store
         policy, not an OS runtime check, and Unibot ships as a sideload.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- unibot: the hub connection (this phone reachable from the user's other devices) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- T50: PARTIAL_WAKE_LOCK held by AgentForegroundService while sessions
         are streaming so Doze + OEM CPU throttling don't stall long shell
         tools after screen-off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- T-bg-overlay phase 2: floating tool-status capsule rendered via
         WindowManager TYPE_APPLICATION_OVERLAY while Unibot is backgrounded
         and an agent task is in flight. The user must additionally grant
         "Display over other apps" the first time they toggle the feature
         on; the app silently falls back to the Phase 1 notification when
         the permission is missing. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- T50: deep-link the user to the system battery-optimisation
         exemption dialog when they tap the Background settings row. The
         permission only governs whether ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         can be issued without falling through to the broader settings list. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- unibot: the alarm receiver must stay exported for BOOT_COMPLETED, but only the
         system and this app (its own AlarmManager PendingIntents) may broadcast to it;
         a signature permission keeps other apps from posting alarm notifications. -->
    <permission
        android:name="${applicationId}.permission.ALARM"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.ALARM" />
    <!-- [T-android-dynamic-island] Android 16 (Baklava) Live Updates: lets the
         ongoing agent-status notification be promoted to the always-visible
         status-chip / "dynamic island" surface. Non-runtime (install-time)
         permission; ignored on pre-16 devices. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- T36: WRITE_CONTACTS — required by `android-contacts delete <id>`. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Legacy WRITE grant needed on Android 10 base ROMs (e.g. HarmonyOS 2.x /
         EMUI 11, Huawei Mate 40 ELS-AN00) so requestLegacyExternalStorage can
         hand PRoot the /mnt/runtime/write FUSE view. Those ROMs never expose the
         Android-11 "All Files Access" page, so MANAGE_EXTERNAL_STORAGE is
         ungrantable there; legacy storage is the only path that lets proot
         readdir a mounted external folder. Capped at API 29 — ignored on 11+. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- T219: Mount External Folders bind-mounts SAF-picked tree URIs into
         /var/minis/mounts/ via PRoot. PRoot's bind translates `readdir(/var/minis/mounts/X)`
         into a host-side `readdir(/storage/emulated/0/...)` running as the app uid.
         Without MANAGE_EXTERNAL_STORAGE, FuseDaemon (MediaProvider) silently filters
         out files owned by other packages from getdents64 results — so an Obsidian
         vault mounted into Unibot would only show files Unibot itself wrote, not the
         vault's actual notes. This permission grants the app uid full POSIX access
         (read + write + readdir) to /storage/emulated/0/, matching the user's mental
         model of "the folder they picked is the folder Unibot sees". -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- "Take Photo" composer entry. We never use the camera background; the
         permission is requested at the moment the user taps the menu item. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- T262-1: required to dispatch AlarmClock.ACTION_SET_ALARM to
         com.google.android.deskclock/.HandleSetApiCalls. The receiving
         activity is permission-protected; without this normal-protection
         permission the OS throws SecurityException at startActivity time
         and android-alarm's dual-write silently degrades to the internal
         AlarmManager copy only. T259 added <queries> + FLAG_ACTIVITY_NEW_TASK
         which made resolveActivity report the target, but resolution alone
         doesn't unblock the call — the permission does. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- [T-android-privileged-backend] AXManager only pushes its binder to
         apps whose requestedPermissions list contains one of three sentinels
         (see AxManager BinderSender#sendBinder). Without one of these
         declared, AXManager skips us and Shizuku.pingBinder() stays false
         even though AXManager's service is running. Shizuku itself does NOT
         need this permission — it discovers clients via its ContentProvider
         + INTERACT_ACROSS_USERS_FULL gating — but declaring it is the
         standard Shizuku-client manifest practice (used by Magisk Manager,
         Brevent, etc.) and unlocks the AXManager push path. The permission
         is normal-protection and isn't actually granted; AXManager only
         checks that we *requested* it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Package visibility for speech recognition services + Custom Tabs
         (Android 11+ scoped queries). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- unibot: the hands (0.1.12) list the apps with a launcher icon, so the
             screen model can open one by name. Android 11+ package visibility. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- T234: needed for androidx.browser CustomTabsClient.bindCustomTabsService
             to discover the user's Chrome (or any Custom Tabs provider) under
             Android 11+ package-visibility rules. Without this the bind silently
             returns false and Google login navigation falls back to the
             ACTION_VIEW path. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- T259: surface the system Clock app for diagnostics so
             android-alarm's dual-write resolveActivity returns non-null
             on Android 11+. SET_ALARM is in the visibility allowlist
             so startActivity already works without this, but the
             pre-flight resolve gives us a cleaner log/fallback path. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- T266b: SET_TIMER for android-alarm timer — same Clock activity
             handles it, but the queries entry keeps resolveActivity honest
             on Android 11+. The com.android.alarm.permission.SET_ALARM perm
             gates dispatch for both SET_ALARM and SET_TIMER. -->
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- T322: Shizuku — package-visibility entry so we can detect whether the
             user has the Shizuku Manager app installed and report accurate state
             in Settings (NOT_INSTALLED vs NOT_RUNNING vs RUNNING_NEED_PERM …). -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- [T-android-privileged-backend] AXManager — same package-visibility
             need so PrivilegedBackend can detect/launch it under Android 11+. -->
        <package android:name="frb.axeron.manager" />
        <!-- Crash-share dialog: ACTION_SENDTO mailto: needs explicit
             visibility under Android 11+ before resolveActivity / startActivity
             will return a real email-app candidate. Without it the
             pre-flight resolveActivity always returns null and we fall
             through to the generic share chooser. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- [v0.7.0-whatsapp] Android 11+ package visibility: lets the
             WhatsApp share intent resolve com.whatsapp directly. Without this
             resolveActivity() returns null even when WhatsApp is installed. -->
        <package android:name="com.whatsapp" />
    </queries>

    <!-- [T-android-tablet-split] enableOnBackInvokedCallback (on <application>):
         predictive-back gesture animations, which NavigableListDetailPaneScaffold
         uses for its list<->detail back transition. Required on Android 13-15;
         16+ enables it by default, so this is the compatibility switch rather
         than a new behaviour. -->
    <application
        android:name=".UnibotApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/unibot_backup_rules"
        android:dataExtractionRules="@xml/unibot_data_extraction_rules"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Unibot">

        <!-- [T-android-tablet-split] MainActivity resize/rotation handling.

             configChanges + resizeableActivity: without them the Activity is
             DESTROYED and recreated when the user drags a split-screen divider,
             resizes a freeform window or rotates — which drops the pane
             navigator's state and, worse, interrupts an in-flight streaming
             reply. screenSize + smallestScreenSize + screenLayout cover
             multi-window resize; orientation covers rotation.

             Safe here because the UI is Compose: layout is driven by
             currentWindowAdaptiveInfo(), which recomposes on configuration
             change, so nothing depends on the recreate to re-read resources. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Unibot"
            android:windowSoftInputMode="adjustResize">
            <!-- T-android-dynamic-app-icon: LAUNCHER intent-filter moved
                 to the <activity-alias> entries below so the user can pick
                 an alternate icon. Exactly one alias is enabled at a time
                 (PackageManager.setComponentEnabledSetting); MainActivity
                 itself never appears in the launcher directly, but all
                 internal Intent(this, MainActivity::class.java) startActivity
                 calls keep working because MainActivity is always enabled.
                 The unibot:// deep-link filter stays on MainActivity since
                 deep-links never go through the LAUNCHER category. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unibot" />
                <!-- Legacy scheme: old chats may still contain minis:// links. -->
                <data android:scheme="minis" />
            </intent-filter>
        </activity>

        <!-- T-android-dynamic-app-icon: launcher-icon aliases. Exactly
             ONE of these three is enabled at any time; AppIconRepository
             flips the enabled state in response to a Settings → App Icon
             tap. All three target MainActivity, so the user-visible
             launcher entry just swaps icon + label, no actual activity
             change. Pre-install state: "auto" is enabled in the manifest
             (android:enabled="true"), the other two are disabled. -->
        <activity-alias
            android:name=".MainActivityIconAuto"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T-android-app-icon-shortcuts: app-icon long-press quick
                 actions (mirrors iOS QuickActionRouter / UIApplicationShortcutItem).
                 Three static shortcuts (new_chat / voice_chat / camera_chat)
                 launch MainActivity via unibot://action/<name> deep-link.
                 The shortcuts meta-data must live on the alias that owns
                 the LAUNCHER filter, not on MainActivity itself. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIconLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIconDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Share receiver activity -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.Unibot">
            <!-- T157: widen mime to */* so Unibot appears in the system share
                 sheet for any file type (xml/pdf/zip/audio/video/…). The
                 narrower text/plain + image/* + application/* set hid Unibot
                 from the chooser whenever the source app declared a more
                 specific mime. ShareReceiverActivity already handles any
                 incoming mime via the T185/T150 attachment path, so the
                 wildcard is safe. Mirrors LocalSend's behaviour. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- T142: ACTION_VIEW filters so Unibot appears in the system
                 "Open with" chooser triggered by other apps (Telegram tap-to-
                 open, gallery long-press → Open with, file manager Open as…).
                 Each mime is its own filter — using "*/*" would force Unibot
                 into every file chooser on the device and several OEM ROMs
                 actively reject the registration. Mirror only mimes a chat
                 composer can usefully prefill: images, PDFs, plain/structured
                 text, audio/video files, common app archives. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- T163: register for the system "Open with" chooser when the
                 user taps a file in Files / Photos / any document viewer.
                 The T142 filters above only fire for BROWSABLE intents
                 (web links, deep-links) and never list Unibot in the OEM
                 file manager's chooser. Termux's working pattern is
                 scheme=file + scheme=content + mimeType=*/* without
                 BROWSABLE — file managers don't tag intents BROWSABLE.
                 ShareReceiverActivity.handleView already routes the
                 intent.data uri through the same T185/T150 attachment
                 path, so any mime is safe. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- v0.2.0 P3: text-entry sheet behind the "Quick ask" widget.
             Translucent + noHistory + excluded from recents so it feels
             like a sheet over the launcher, not an app screen. -->
        <activity
            android:name=".widget.QuickAskActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- T-pwa-1 (renamed Pwa → WebApp): WebApp shortcut host.
             Reachable only via explicit Intent from a pinned launcher
             shortcut (ACTION_OPEN_WEBAPP + extras). Old ACTION_OPEN_PWA
             intent-filter intentionally removed: per user direction,
             home-screen icons pinned before the rename are not preserved
             and will return "intent not found" on tap; the user has to
             re-add them from inside the app. -->
        <activity
            android:name=".webapp.WebAppActivity"
            android:label="@string/webapp_activity_label"
            android:launchMode="singleInstance"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:theme="@style/Theme.Unibot">
            <intent-filter>
                <action android:name="ai.unicto.unibot.action.OPEN_WEBAPP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- OAuth callback handler: captures localhost redirects for all providers -->
        <!-- Prevents "Choose activity" dialog when OAuth provider redirects to localhost -->
        <activity
            android:name=".auth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <!-- Claude: http://localhost:54545/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="54545"
                    android:path="/callback" />
            </intent-filter>
            <!-- OpenAI: http://localhost:1455/auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="1455"
                    android:path="/auth/callback" />
            </intent-filter>
            <!-- Gemini: http://localhost:8085/oauth2callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="8085"
                    android:path="/oauth2callback" />
            </intent-filter>
            <!-- OpenRouter: http://localhost:3000/callback (+fallback ports) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="3000"
                    android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="3001"
                    android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="3002"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Agent foreground service -->
        <!-- T-android-fgs-timeout-crash: type=mediaPlayback to escape the
             dataSync 6h cap. See FOREGROUND_SERVICE_MEDIA_PLAYBACK
             permission comment above. -->
        <service
            android:name=".service.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Alarm broadcast receiver (also handles BOOT_COMPLETED for re-scheduling) -->
        <receiver
            android:name=".offload.AlarmReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.ALARM">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Scheduled notification receiver — fires `android-notification schedule`
             alarms so the deferred notification posts at the requested time. -->
        <receiver
            android:name=".offload.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- [T-android-scheduled-tasks-design] AlarmManager target for
             user-defined scheduled tasks (Settings → home top-right
             schedule icon). The receiver dispatches to ScheduledAgentRunner
             which drives the agent loop headlessly. -->
        <receiver
            android:name=".scheduled.ScheduledTaskAlarmReceiver"
            android:exported="false" />

        <!-- v0.2.0 P3: home-screen widgets. Exported=false per the
             AppWidgetProvider contract — the system delivers APPWIDGET_UPDATE
             to the explicit component; the custom ROUTINES_CHANGED action is
             broadcast by our own ScheduledTaskManager only. -->
        <receiver
            android:name=".widget.QuickAskWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_ask_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.TasksWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="ai.unicto.unibot.ROUTINES_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!-- v0.2.0 P3: the Tasker / Automate / MacroDroid intent API —
             ai.unicto.unibot.ASK / NEW_CHAT / RUN_ROUTINE. Exported so
             automation apps can send the broadcasts; no auth needed, it is
             the user's own device. -->
        <receiver
            android:name=".automation.TaskerIntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.unicto.unibot.ASK" />
                <action android:name="ai.unicto.unibot.NEW_CHAT" />
                <action android:name="ai.unicto.unibot.RUN_ROUTINE" />
            </intent-filter>
        </receiver>

        <!-- unibot: Allow / Deny buttons on the approval notification -->
        <receiver
            android:name="ai.unicto.unibot.guard.RiskApprovalReceiver"
            android:exported="false" />

        <!-- unibot: default digital assistant support. Declaring a
             VoiceInteractionService is what makes unibot appear in
             Settings → Apps → Default apps → Digital assistant app.
             Invoking it opens a new chat with voice input auto-started. -->
        <service
            android:name=".assist.UnibotVoiceInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <!-- Notification listener — lets android-notification read active notifications.
             User must enable this manually in Settings → Notifications → Device &
             app notifications → Notification access. -->
        <service
            android:name=".offload.UnibotNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- [v0.7.0-whatsapp] Opt-in WhatsApp notification reader. Bound by
             the system only when the user grants Notification Access for
             THIS component in system settings (toggled from Settings →
             Connectors → WhatsApp). On-device only: captures go straight to
             an in-memory ring buffer — never logged, never persisted. -->
        <service
            android:name=".service.WhatsAppListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- T322: Shizuku in-process content provider. Required by Shizuku
             SDK >=12 to host the binder receiver inside our process. Marked
             multiprocess=false so :acra reporter process doesn't try to host
             a second copy. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- [T-android-privileged-backend] AXManager (Axeron) reuses this
             same `<applicationId>.shizuku` ShizukuProvider — its
             AxeronService#sendBinderToUserApp() resolves
             "$packageName.shizuku" and calls Shizuku's "sendBinder" provider
             method with extra "moe.shizuku.privileged.api.intent.extra.BINDER"
             (verified in fahrez182/AxManager server/AxeronService.kt). The
             only client-side requirement is the API_V23 uses-permission
             above; no separate provider or AIDL surface is needed. -->

        <!-- FileProvider for sharing exported JSON (provider config, etc.)
             to other apps. Paths exposed are under app-scoped cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- T323: AccessibilityService backing `android-a11y-cli`. The user
             must enable this manually under Settings → Accessibility; we
             never start it programmatically (Android forbids that). -->
        <service
            android:name=".accessibility.UnibotAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/unibot_accessibility_service" />
        </service>

        <!-- unibot: keeps the phone on the hub in the background -->
        <service
            android:name="ai.unicto.unibot.hub.HubService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- [P1-qs-tile] Quick Settings tiles: "Voice ask" opens a new chat
             with voice input engaged, "New chat" opens a fresh draft. Both
             fire the matching unibot://action/… deep link at MainActivity.
             User-added from the QS editor; BIND_QUICK_SETTINGS_TILE is the
             required permission for TileService. -->
        <service
            android:name=".qs.UnibotVoiceTileService"
            android:exported="true"
            android:label="@string/qs_tile_voice_ask"
            android:icon="@drawable/ic_shortcut_voice_chat"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".qs.UnibotNewChatTileService"
            android:exported="true"
            android:label="@string/qs_tile_new_chat"
            android:icon="@drawable/ic_shortcut_new_chat"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- P6: autofill service — strictly opt-in (in-app toggle + the user
             must also pick unibot in system autofill settings). Fills only
             name/email/phone from the on-device profile; never saves forms,
             never networks. Disabled by default. -->
        <service
            android:name=".autofill.UnibotAutofillService"
            android:exported="true"
            android:label="unibot Autofill"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

    </application>
</manifest>
