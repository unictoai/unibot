# cloud.unibot.cn — unibot Cloud (the sign-in relay and the hub), served by
# the showcase's Caddy next to unibot.cn. Goes into demo/showcase/sites.d/;
# the relay container (cloud/deploy/unibot-hk/docker-compose.yml) is on the
# same `showcase_edge` network as `unibot-relay`. Certificate the ordinary
# way, HTTP-01: the name points straight at this box.

cloud.unibot.cn {
	# compressed, except the operator's samples export: it is sent whole with its length,
	# and a download that gets re-encoded on the way has none — the browser gave up on it
	@compressible not path /v1/admin/samples/export
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The console at /app is a small static app; the API is JSON. One frame of
	# the hub may carry a file or a screenshot, which is why the body limit is
	# what HUB_FRAME_LIMIT says rather than Caddy's default.
	request_body {
		max_size 16MB
	}

	reverse_proxy unibot-relay:8787 {
		# Chat streams (SSE) and the hub's WebSocket must not be buffered.
		flush_interval -1
		# 10 minutes idle: a hub socket pings every 25 s, a long chat answer
		# streams; nothing legitimate sits silent longer than this.
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
